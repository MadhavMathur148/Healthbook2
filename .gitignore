*.pem
*.key
*.p12
*.p8
*.pfx
*.mobileprovision
secrets.properties
keystore.properties
signing.properties
google-services.json
GoogleService-Info.plist
service-account*.json
# Signing keys never go in git. Only the encrypted release key does.
*.jks
*.keystore

